---
import OptimizedImage from '@/components/OptimizedImage.astro';
import { categories } from '@/data/categories';
import { getGallery } from '@/data/galleries';

const fallback = [
  { src: 'gallery-1.png', alt: 'Wedding work', caption: 'Wedding Photography', w: 1160, h: 773 },
  { src: 'gallery-2.png', alt: 'Portrait work', caption: 'Portrait Session', w: 1160, h: 773 },
  { src: 'gallery-3.png', alt: 'Celebration work', caption: 'Celebration', w: 1160, h: 773 },
  { src: 'gallery-4.png', alt: 'Studio portrait', caption: 'Studio Portrait', w: 1160, h: 773 },
  { src: 'gallery-5.png', alt: 'Baby portrait', caption: 'Baby Photoshoot', w: 832, h: 1159 },
  { src: 'gallery-6.png', alt: 'Birthday portrait', caption: 'Birthday', w: 795, h: 1159 },
];

const slugCounts = new Map<string, number>();

const pool = categories.flatMap((cat) =>
  (getGallery(cat.slug)?.photos ?? []).slice(0, 2).map((p) => {
    const n = (slugCounts.get(cat.slug) ?? 0) + 1;
    slugCounts.set(cat.slug, n);
    return {
      src: p.src,
      alt: p.alt,
      caption: cat.title,
      href: `/gallery/${cat.slug}/`,
      linkLabel: n === 1 ? `${cat.title} gallery` : `More ${cat.title}`,
      w: p.width,
      h: p.height,
    };
  }),
);

const works = (pool.length >= 6 ? pool : pool.length > 0 ? pool : fallback)
  .slice(0, 12)
  .map((p, i) => ({
    src: p.src,
    alt: p.alt,
    caption: p.caption,
    href: 'href' in p ? p.href : `/gallery/`,
    linkLabel:
      'linkLabel' in p && p.linkLabel
        ? p.linkLabel
        : i === 0
          ? 'Selected work gallery'
          : `Portfolio image ${i + 1}`,
    w: p.w,
    h: p.h,
  }));
---

<section class="works" id="works" data-works-section>
  <div class="works__inner">
    <header class="works__header">
      <p class="section-label works__eyebrow">Selected Work</p>
      <div class="works__title-wrap">
        <h2 class="section-title works__title" data-works-title>Moments We've Preserved</h2>
        <span class="works__rule" aria-hidden="true"></span>
      </div>
    </header>

    <div class="works__grid" data-works-grid>
      {
        works.map((item, i) => (
          <article
            class:list={['works__item', i < 3 && 'works__item--hero']}
            data-works-item
            data-works-hero={i < 3 ? i : undefined}
          >
            <div class="works__item-frame">
              <a class="works__link" href={item.href}>
                <div class="works__media" data-works-media>
                  <OptimizedImage
                    src={item.src}
                    alt={item.alt}
                    width={item.w}
                    height={item.h}
                    sizes="(max-width: 640px) 100vw, 392px"
                  />
                </div>
                <span class="sr-only">{item.linkLabel}</span>
              </a>
              <div class="works__overlay" aria-hidden="true">
                <span class="works__caption">{item.caption}</span>
                <span class="works__cta">View gallery</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .works {
    margin-top: -32vh;
    margin-top: -32lvh;
    padding: 0 var(--figma-gutter) clamp(6rem, 12vw, 140px);
    background: var(--color-bg);
    position: relative;
    z-index: 4;
  }

  :global(html.lens-photos-active) .works {
    z-index: 6;
    background: transparent;
    margin-top: -38vh;
    margin-top: -38lvh;
    padding-top: 0;
  }

  :global(html.lens-handoff-done) .works {
    z-index: 1;
    background: var(--color-bg);
    margin-top: 0;
    padding-top: clamp(5rem, 10vw, 7.5rem);
  }

  :global(html.lens-handoff-done) .works::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(420px, 60vw);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgb(201 169 98 / 0.55) 50%,
      transparent 100%
    );
    pointer-events: none;
  }

  .works__inner {
    max-width: var(--figma-max);
    margin: 0 auto;
  }

  .works__header {
    text-align: center;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  :global(html.lens-photos-active) .works__header {
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
  }

  :global(html.lens-photos-active) .works__eyebrow {
    opacity: 0;
    transform: translateY(8px);
  }

  :global(html.lens-handoff-done) .works__eyebrow {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .works__eyebrow {
    margin-bottom: 0.75rem;
    font-size: clamp(1.25rem, 2vw, 1.75rem);
  }

  .works__title-wrap {
    min-height: clamp(3rem, 7vw, 4.5rem);
    max-width: 900px;
    margin: 0 auto;
  }

  .works__title {
    max-width: 900px;
    margin: 0 auto;
    line-height: 1.1;
    opacity: var(--title-opacity, 0);
    transform: translateY(calc((1 - var(--title-opacity, 0)) * 14px));
    filter: blur(calc((1 - var(--title-opacity, 0)) * 4px));
    will-change: opacity, transform, filter;
  }

  .works__rule {
    display: block;
    width: clamp(48px, 8vw, 72px);
    height: 1px;
    margin: 1.25rem auto 0;
    background: var(--color-accent);
    opacity: calc(var(--title-opacity, 0) * 0.85);
    transform: scaleX(calc(0.4 + var(--title-opacity, 0) * 0.6));
    transform-origin: center;
    will-change: opacity, transform;
  }

  .works__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem) clamp(1.5rem, 4vw, 4.5rem);
    grid-template-columns: 1fr;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .works__grid {
      grid-template-columns: repeat(2, minmax(0, 392px));
    }
  }

  @media (min-width: 1100px) {
    .works__grid {
      grid-template-columns: repeat(3, 392px);
      gap: 4.5rem 4.5rem;
    }

    .works__item:nth-child(3n + 2) {
      margin-top: 2.75rem;
    }

    .works__item:nth-child(n + 4):nth-child(3n + 1) {
      margin-top: 1.25rem;
    }
  }

  .works__item {
    --reveal: 0;
    --parallax-y: 0;
  }

  .works__link {
    display: block;
    text-decoration: none;
    color: inherit;
    outline: none;
  }

  .works__link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .works__item-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    background: rgb(12 12 12 / 0.6);
    box-shadow:
      0 0 0 1px rgb(201 169 98 / calc(var(--reveal) * 0.12)),
      0 calc(var(--reveal) * 28px) calc(var(--reveal) * 48px) rgb(0 0 0 / calc(var(--reveal) * 0.35));
    clip-path: inset(calc((1 - var(--reveal)) * 14%) round var(--radius));
    transform: translateY(calc((1 - var(--reveal)) * 24px));
    will-change: clip-path, transform, box-shadow;
  }

  .works__media {
    transform: scale(calc(1.14 - var(--reveal) * 0.14))
      translateY(calc(var(--parallax-y) * 1px));
    transform-origin: center center;
    will-change: transform;
  }

  .works__item :global(.photo-frame) {
    aspect-ratio: 392 / 440;
    width: 100%;
    transition: filter 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .works__item-frame:has(.works__link:hover) :global(.photo-frame),
  .works__item-frame:has(.works__link:focus-visible) :global(.photo-frame) {
    filter: brightness(1.06);
  }

  .works__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.75rem 1.25rem 1.25rem;
    background: linear-gradient(
      to top,
      rgb(3 3 3 / 0.92) 0%,
      rgb(3 3 3 / 0.35) 42%,
      transparent 72%
    );
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .works__item-frame:has(.works__link:hover) .works__overlay,
  .works__item-frame:has(.works__link:focus-visible) .works__overlay {
    opacity: 1;
    transform: translateY(0);
  }

  .works__caption {
    font-family: var(--font-serif);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.25;
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  .works__cta {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    :global(html.lens-handoff-done) .works {
      padding-top: 4rem;
    }

    .works__header {
      margin-bottom: 2.25rem;
    }

    .works__grid {
      gap: 1.75rem;
    }

    .works__item:nth-child(3n + 2) {
      margin-top: 0;
    }

    .works__overlay {
      opacity: 1;
      transform: none;
      background: linear-gradient(to top, rgb(3 3 3 / 0.88) 0%, transparent 55%);
    }

    .works__cta {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .works {
      margin-top: 0;
      padding-top: 4rem;
    }

    .works__title,
    .works__rule {
      opacity: 1;
      transform: none;
      filter: none;
    }

    .works__eyebrow {
      opacity: 1;
      transform: none;
    }

    .works__item {
      --reveal: 1;
      --parallax-y: 0;
    }

    .works__item-frame {
      clip-path: none;
      transform: none;
      box-shadow: none;
    }

    .works__media {
      transform: none;
    }

    .works__item :global(.photo-frame) {
      transition: none;
    }
  }
</style>

<script>
  import { LENS, clamp, easePremium, lensSegment, shutterProgress } from '@/lib/lensScroll';
  import { lerp, parallaxTarget, revealTarget } from '@/lib/galleryScroll';

  const section = document.getElementById('works') as HTMLElement | null;
  const shutter = document.querySelector('[data-shutter-scroll]') as HTMLElement | null;
  const heroItems = [...document.querySelectorAll('[data-works-hero]')] as HTMLElement[];
  const scrollItems = [...document.querySelectorAll('[data-works-item]')] as HTMLElement[];

  if (section) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const LERP = 0.09;

    type ItemState = { reveal: number; parallax: number };
    const state = new Map<HTMLElement, ItemState>();
    scrollItems.forEach((el) => state.set(el, { reveal: 0, parallax: 0 }));

    const applyStyles = (el: HTMLElement, reveal: number, parallax: number) => {
      el.style.setProperty('--reveal', String(reveal));
      el.style.setProperty('--parallax-y', String(parallax));
    };

    const applyHeroReveal = (p: number) => {
      const photoT = lensSegment(p, LENS.PHOTOS_START, LENS.PHOTOS_END, easePremium);

      heroItems.forEach((el) => {
        const index = Number(el.dataset.worksHero ?? 0);
        const stagger = index * 0.07;
        const local = clamp((photoT - stagger) / (1 - stagger * 0.65));
        const reveal = easePremium(local);
        const s = state.get(el)!;
        s.reveal = reveal;
        applyStyles(el, reveal, 0);
      });
    };

    const applyTitle = (p: number) => {
      const opacity = lensSegment(p, LENS.TITLE_IN, LENS.TITLE_FULL, easePremium);
      section.style.setProperty('--title-opacity', String(opacity));
    };

    const shutterHandoffComplete = () => {
      if (!shutter) return true;
      const p = shutterProgress(shutter);
      return p >= LENS.PHOTOS_END || shutter.getBoundingClientRect().bottom <= 0;
    };

    const tickScrollGallery = () => {
      scrollItems.forEach((el) => {
        const s = state.get(el)!;
        const targetReveal = revealTarget(el);
        const targetParallax = parallaxTarget(el);
        s.reveal = lerp(s.reveal, targetReveal, LERP);
        s.parallax = lerp(s.parallax, targetParallax, LERP);
        if (Math.abs(s.reveal - targetReveal) < 0.002) s.reveal = targetReveal;
        if (Math.abs(s.parallax - targetParallax) < 0.15) s.parallax = targetParallax;
        applyStyles(el, s.reveal, s.parallax);
      });
    };

    const updateShutterPhase = () => {
      if (reducedMotion.matches) {
        section.style.setProperty('--title-opacity', '1');
        scrollItems.forEach((el) => applyStyles(el, 1, 0));
        return;
      }

      if (!shutter) {
        tickScrollGallery();
        return;
      }

      const p = shutterProgress(shutter);
      applyTitle(p);

      if (!shutterHandoffComplete()) {
        applyHeroReveal(p);
        scrollItems.forEach((el, i) => {
          if (i >= 3) applyStyles(el, 0, 0);
        });
        return;
      }

      section.style.setProperty('--title-opacity', '1');
      tickScrollGallery();
    };

    let rafId = 0;
    const loop = () => {
      updateShutterPhase();
      rafId = requestAnimationFrame(loop);
    };

    if (reducedMotion.matches) {
      updateShutterPhase();
    } else {
      rafId = requestAnimationFrame(loop);
    }

    window.addEventListener('resize', updateShutterPhase, { passive: true });
    reducedMotion.addEventListener('change', () => {
      cancelAnimationFrame(rafId);
      if (reducedMotion.matches) {
        updateShutterPhase();
      } else {
        rafId = requestAnimationFrame(loop);
      }
    });
  }
</script>
